 document.getElementById('ndcInput').addEventListener('input', async function () {
    const ndc = this.value.trim().replace(/[-\s]/g, '');

    if (ndc.length === 11 && /^\d{11}$/.test(ndc)) {
      const drugData = await fetchDrugDetailsByNDC(ndc);
      //console.log('Drug Data Fetched:', drugData);

      if (drugData) {
        fillDrugDetailsFromAPI(drugData);
        document.getElementById('errorMessage').textContent = '';
        document.getElementById('searchButton').style.display = 'none';
        document.getElementById('or-id').style.display = 'none';
      } else {
        document.getElementById('errorMessage').textContent = 'No drug found for this NDC.';
      }
    }
  });

  async function fetchDrugDetailsByNDC(ndc) {
    try {
      const res = await fetch(`${baseUrl}/DrugDataByIdentifier?searchType=NDC&search=${ndc}`, {
        headers: {
          'Content-Type': 'application/json',
          'apiKey': apiKey // Remove or replace with actual API key if not needed
        }
      });

      if (!res.ok) {
        console.error('Failed to fetch drug data:', await res.text());
        return null;
      }

      const data = await res.json();
      return data?.[0] || null;
    } catch (err) {
      console.error('Error fetching NDC data:', err);
      return null;
    }
  }

  function fillDrugDetailsFromAPI(drug) {
    const drugName = drug.MedDrugName || '';
    const form = drug.DosageForm || '';
    const strength = (drug.MedStrength && drug.Uom) ? `${drug.MedStrength} ${drug.Uom}` : '';
    const quantity = (!isNaN(parseFloat(drug.MedPackSize)))
  ? Math.round(parseFloat(drug.MedPackSize) * 10) / 10
  : 30;

    document.getElementById('inputDrugs').value = drugName;

    const formDropdown = document.getElementById('formDropdown');
    formDropdown.innerHTML = `<option value="${form}" selected>${form}</option>`;

    const dosageDropdown = document.getElementById('dosageDropdown');
    dosageDropdown.innerHTML = `<option value="${strength}" selected>${strength}</option>`;

    document.getElementById('quantity').value = quantity;

    selectedDrug = drug;
  }

</script>
